# Opcional: use o endpoint invisível fornecido pelo FormSubmit para não expor o destinatário no código do servidor.
CONTACT_FORM_ENDPOINT=https://formsubmit.co/ajax/seu-token-invisivel

# Opcional: origens adicionais, separadas por vírgula. A origem que recebeu a requisição já é aceita automaticamente.
CONTACT_ALLOWED_ORIGINS=https://seu-dominio.com.br,https://www.seu-dominio.com.br
